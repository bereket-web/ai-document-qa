# Local data store. Keep this file private if it is changed to include secrets.
DOCQA_DB_PATH=./data/document_qa.sqlite3
DOCQA_EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
DOCQA_CHUNK_WORDS=180
DOCQA_OVERLAP_WORDS=35
DOCQA_TOP_K=5
DOCQA_MAX_FILE_BYTES=15728640

# Optional OpenAI-compatible answer generation. Leave blank for local extractive answers.
# Configure only if you accept sending retrieved document passages to that provider.
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4o-mini
